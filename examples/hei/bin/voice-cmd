#!/usr/bin/env python3
"""voice-cmd: match a spoken utterance against command plugins and run it.

  voice-cmd handle "TEXT"   run the matching command; exit 0 if handled, 1 if not
  voice-cmd match  "TEXT"   print the match (name, argv) without running it
  voice-cmd list            list loaded commands

Commands are TOML plugin files in $VOICE_CMD_DIRS (default
~/.config/voice-commands and the repo's commands/). Each file holds
[[command]] tables:

  [[command]]
  name    = "hover.tidy"
  phrases = ["tidy (up )?my tabs", "group (my )?tabs by site"]
  app     = "hover"                 # optional: window class under the cursor
                                    # or focused; omit for a global command
  run     = ["hover-cmd", "tidy"]   # argv; {1}, {2}... = regex groups
  sync    = true                    # optional: wait for it; handled only if
                                    # it exits 0 (a name it could not find
                                    # falls through and is typed)

A phrase must match the WHOLE utterance after politeness and filler are
stripped, so ordinary dictation passes through to the agents untouched.
"""
import json, os, re, subprocess, sys, tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
DIRS = os.environ.get("VOICE_CMD_DIRS",
                      f"{Path.home()}/.config/voice-commands:{HERE}/commands").split(":")
LOG = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "voice-cmd.log"

FILLER = r"(uh|um|erm|like|just|please|okay|ok|hey|so|and|yeah|now)"
PREFIX = re.compile(rf"^(({FILLER}|(can|could|would|will) you|i want you to|go ahead and)\s+)+")
SUFFIX = re.compile(rf"(\s+({FILLER}|for me|over|thanks|thank you))+$")
NUMBERS = {w: str(i) for i, w in enumerate(
    "zero one two three four five six seven eight nine ten".split())}


def normalize(text):
    t = re.sub(r"[^\w\s']", " ", text.lower())
    t = re.sub(r"\s+", " ", t).strip()
    prev = None
    while prev != t:
        prev, t = t, SUFFIX.sub("", PREFIX.sub("", t)).strip()
        t = re.sub(rf"\b{FILLER}\b\s+(?={FILLER}\b)", "", t)
    return " ".join(NUMBERS.get(w, w) for w in t.split())


def load():
    cmds = []
    for d in DIRS:
        for f in sorted(Path(d).glob("*.toml")) if Path(d).is_dir() else []:
            for c in tomllib.loads(f.read_text()).get("command", []):
                c["_res"] = [re.compile(rf"^(?:{p})$") for p in c["phrases"]]
                c["_file"] = str(f)
                cmds.append(c)
    return cmds


def window_context():
    """Classes of the window under the cursor and the focused window."""
    def hy(*a):
        return json.loads(subprocess.run(["hyprctl", "-j", *a], capture_output=True,
                                         text=True, timeout=2).stdout or "null")
    try:
        cur, active, clients = hy("cursorpos"), hy("activewindow") or {}, hy("clients")
        mons = {m["id"]: m for m in hy("monitors")}
        visible = {m["activeWorkspace"]["id"] for m in mons.values()} | \
                  {m["specialWorkspace"]["id"] for m in mons.values()}
        hovered = None
        # clients are listed bottom-up-ish; prefer focused, then floating
        for c in sorted(clients, key=lambda c: (c["focusHistoryID"])):
            (x, y), (w, h) = c["at"], c["size"]
            if c["workspace"]["id"] in visible and x <= cur["x"] < x + w and y <= cur["y"] < y + h:
                hovered = c
                break
        return {"hovered": (hovered or {}).get("class", ""), "focused": active.get("class", "")}
    except Exception:
        return {"hovered": "", "focused": ""}


def match(text, ctx=None):
    t = normalize(text)
    if not t:
        return None
    cands = []
    for c in load():
        for rx in c["_res"]:
            m = rx.match(t)
            if m:
                cands.append((c, m))
                break
    if not cands:
        return None
    if not ctx and os.environ.get("VOICE_CMD_APP"):  # testing: pretend this app is hovered
        ctx = {"hovered": os.environ["VOICE_CMD_APP"], "focused": ""}
    ctx = ctx or window_context()
    def score(cm):
        app = cm[0].get("app")
        if not app:
            return 1
        if re.fullmatch(app, ctx["hovered"]):
            return 3
        if re.fullmatch(app, ctx["focused"]):
            return 2
        return 0
    c, m = max(cands, key=score)
    if score((c, m)) == 0:
        return None
    argv = [re.sub(r"\{(\d+)\}", lambda g: m.group(int(g[1])) or "", a) for a in c["run"]]
    return {"name": c["name"], "argv": argv, "normalized": t, "ctx": ctx, "sync": bool(c.get("sync"))}


def main():
    cmd, *rest = sys.argv[1:] or ["list"]
    text = " ".join(rest)
    if cmd == "list":
        for c in load():
            print(f"{c['name']:24} {c.get('app') or '*':10} {' | '.join(c['phrases'])}")
        return 0
    hit = match(text)
    if cmd == "match":
        print(json.dumps(hit, indent=1))
        return 0 if hit else 1
    if cmd == "handle":
        if not hit:
            return 1
        env = dict(os.environ)
        env["PATH"] = ":".join([str(HERE), f"{Path.home()}/.local/bin",
                                f"{Path.home()}/.cargo/bin", env.get("PATH", "/usr/bin")])
        if hit["sync"]:
            try:
                done = subprocess.run(hit["argv"], env=env, stdin=subprocess.DEVNULL,
                                      stdout=subprocess.DEVNULL, stderr=open(LOG, "a"), timeout=0.7)
            except (OSError, subprocess.TimeoutExpired):
                return 1
            if done.returncode != 0:
                return 1
        with LOG.open("a") as f:
            f.write(json.dumps({"text": text, **hit}) + "\n")
        if not hit["sync"]:
            subprocess.Popen(hit["argv"], env=env, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=open(LOG, "a"))
        if os.environ.get("VOICE_CMD_NOTIFY", "1") == "1":
            subprocess.Popen(["notify-send", "-t", "1500", "-a", "voice-cmd",
                              "-h", "string:x-canonical-private-synchronous:voice-cmd",
                              hit["normalized"], hit["name"]], env=env,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
