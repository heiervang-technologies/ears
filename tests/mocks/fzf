#!/usr/bin/env bash
# Mock fzf for testing

source "${BATS_TEST_DIRNAME}/../test_helper.bash" 2>/dev/null || true
[[ -n "${MOCK_CALL_LOG:-}" ]] && record_mock_call "fzf" "$@"

# Read input and return first line (simulating user selection)
if [[ -n "${MOCK_FZF_SELECTION:-}" ]]; then
    echo "$MOCK_FZF_SELECTION"
elif [[ -n "${MOCK_FZF_CANCEL:-}" ]]; then
    exit 1
else
    # Return first line by default
    head -n 1
fi

exit 0
