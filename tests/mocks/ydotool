#!/usr/bin/env bash
# Mock ydotool for testing

source "${BATS_TEST_DIRNAME}/../test_helper.bash" 2>/dev/null || true
[[ -n "${MOCK_CALL_LOG:-}" ]] && record_mock_call "ydotool" "$@"

# Record the text that was typed
if [[ "$1" == "type" ]]; then
    shift
    echo "$*" >> "$TEST_TEMP_DIR/typed_text.log"
fi

exit 0
