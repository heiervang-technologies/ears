#!/usr/bin/env python3
"""hover-page: steer the visible page in the hover browser by name (voice-friendly).

  hover-page click TARGET            click the best-matching element
  hover-page focus TARGET            focus the best-matching text field
  hover-page type TARGET TEXT        put TEXT into the best-matching field
             [--submit]              ...then press Enter / submit its form
  hover-page type --split WORDS...   same, but the first 1-5 WORDS name the field:
                                     the split whose field matches best wins
  hover-page scroll up|down|top|bottom [N|a bit|a lot]
  hover-page back|forward|reload
  hover-page list [TARGET]           print the top candidates and scores

Options (any position):
  --dry          print what would be hit, change nothing
  --embed        blend in EmbeddingGemma similarity (k8s service, see README)
  --notify       send a desktop notification when nothing matched
  --timing       print per-phase latency to stderr
  --json         (list) machine-readable output
  --port N       BiDi port (default $HOVER_BIDI_PORT or 9333)
  --tab TEXT     act on the first tab whose URL contains TEXT (default: the
                 selected tab; BiDi context ids do not survive a session)

Exit status: 0 acted, 1 nothing matched well enough, 2 error.
Needs hover started with --remote-debugging-port 9333 --remote-allow-system-access.
"""
import base64, difflib, functools, json, math, os, re, socket, struct, sys, time

PORT = int(os.environ.get("HOVER_BIDI_PORT", "9333"))
EMBED_URL = os.environ.get("HOVER_PAGE_EMBED_URL", "http://localhost:30201/v1/embeddings")
EMBED_MODEL = os.environ.get("HOVER_PAGE_EMBED_MODEL", "embeddinggemma-2")
THRESHOLD = 0.55
SANDBOX = "hover-page"

# ---------------------------------------------------------------- matching --

STOP = {"the", "a", "an", "on", "onto", "to", "this", "that", "my", "it", "please", "of"}
# Words that name a kind of element rather than its label.
ROLE_WORDS = {
    "button": "button", "buttons": "button", "btn": "button",
    "link": "link", "links": "link", "hyperlink": "link",
    "field": "field", "box": "field", "bar": "field", "input": "field",
    "textbox": "field", "area": "field", "entry": "field",
    "tab": "tab", "chip": "tab",
    "checkbox": "checkbox", "check": "checkbox", "tick": "checkbox",
    "menu": "menu", "hamburger": "menu", "burger": "menu", "sidebar": "menu",
    "icon": "icon", "logo": "icon",
}
# Label words that are usually filler when spoken ("the rust video").
SOFT = {"video", "page", "item", "option", "thing", "one", "text", "section", "label"}
MENU_RX = re.compile(r"\b(menu|guide|navigation|nav|sidebar|hamburger|drawer|more actions)\b")
HAMBURGER_LABELS = {"menu", "main menu", "open menu", "show menu", "site menu", "guide",
                    "navigation", "open navigation", "toggle navigation", "open sidebar"}
# Matched against whole id/class tokens: "ytd-mini-guide-entry" is a link, not the menu.
HAMBURGER_HINT_RX = re.compile(
    r"(?:^|\s)(?:[\w-]*-)?(?:hamburger|burger|navbar-toggler|guide-button|"
    r"(?:nav|sidebar|drawer|menu)-?(?:toggle|button|btn|trigger))(?:-[\w-]*)?(?=\s|$)")
NAME_WEIGHT = {"labelledby": 1.0, "aria": 1.0, "label": 1.0, "text": 1.0, "value": 0.95,
               "title": 0.95, "placeholder": 0.95, "alt": 0.9, "name": 0.7, "id": 0.6}
EDITABLE_ROLES = {"textbox", "searchbox", "combobox"}


def tokens(s, camel=False):
    if camel:  # ids and name attributes: guideButton -> guide button
        s = re.sub(r"([a-z])([A-Z])", r"\1 \2", s or "")
    return [t for t in re.split(r"[^0-9a-z]+", (s or "").lower()) if t]


def parse_query(q):
    """Split a spoken target into label tokens and role classes."""
    toks = [t for t in tokens(q) if t not in STOP]
    roles = {ROLE_WORDS[t] for t in toks if t in ROLE_WORDS}
    if "text" in toks and ("box" in toks or "field" in toks):
        roles.add("field")
    content = [t for t in toks if t not in ROLE_WORDS]
    return toks, content, roles


@functools.lru_cache(maxsize=65536)
def tok_sim(a, b):
    if a == b:
        return 1.0
    if min(len(a), len(b)) >= 4 and (a.startswith(b) or b.startswith(a)):
        return 0.9
    if a.isdigit() or b.isdigit() or abs(len(a) - len(b)) > max(len(a), len(b)) / 2:
        return 0.0
    m = difflib.SequenceMatcher(None, a, b)
    if m.quick_ratio() < 0.75:
        return 0.0
    r = m.ratio()
    return r if r >= 0.75 else 0.0


def text_sim(qtoks, name, camel=False):
    """Fuzzy similarity of spoken tokens to one accessible name, 0..1.

    Tolerates ASR splitting or joining words ("fire ship", "log in", "e mail")."""
    if not qtoks:
        return 0.0
    nt = tokens(name, camel)
    if not nt:
        return 0.0
    if qtoks == nt or "".join(qtoks) == "".join(nt):
        return 1.0
    n = len(nt)
    ext = nt + [nt[i] + nt[i + 1] for i in range(n - 1)]  # name words, then joined pairs
    spans = [(i,) for i in range(n)] + [(i, i + 1) for i in range(n - 1)]

    def hit(t, pool):
        best, bj = 0.0, None
        for j in range(pool):
            s = tok_sim(t, ext[j])
            if s > best:
                best, bj = s, j
                if s == 1.0:
                    break
        return best, bj

    def combine(hits, weights):
        recall = sum(w * h for w, (h, _) in zip(weights, hits)) / sum(weights)
        used = {i for _, j in hits if j is not None for i in spans[j]}
        return recall, len(used) / n

    weights = [0.3 if t in SOFT else 1.0 for t in qtoks]
    best = combine([hit(t, n) for t in qtoks], weights)
    if best[0] < 1 and (n > 1 or len(qtoks) > 1):
        joined = [hit(t, len(ext)) for t in qtoks]
        tries = [combine(joined, weights)]
        for i in range(len(qtoks) - 1):  # "low fi" -> "lowfi"
            hits = joined[:i] + [hit(qtoks[i] + qtoks[i + 1], len(ext))] + joined[i + 2:]
            tries.append(combine(hits, weights[:i] + [max(weights[i:i + 2])] + weights[i + 2:]))
        best = max([best] + tries)
    recall, precision = best
    if recall == 0:
        return 0.0
    ratio = difflib.SequenceMatcher(None, " ".join(qtoks), " ".join(nt)).ratio()
    return 0.6 * recall + 0.2 * precision + 0.2 * ratio


def is_menuish(c):
    labels = " ".join(t for _, t in c["names"]).lower()
    return bool(MENU_RX.search(labels) or HAMBURGER_HINT_RX.search(c.get("hints", ""))
                or ((c.get("popup") or c.get("toggle")) and c["role"] in ("button", "clickable")))


def hamburger_score(c):
    """How much this looks like THE page menu (for a bare "menu" / "hamburger")."""
    if c["role"] not in ("button", "clickable", "link", "checkbox"):
        return 0.0
    labels = {t.lower() for _, t in c["names"]}
    icon_toggle = c.get("toggle") and not any(src == "text" for src, _ in c["names"])
    if labels & HAMBURGER_LABELS or HAMBURGER_HINT_RX.search(c.get("hints", "")) or icon_toggle:
        s = 0.9
    elif is_menuish(c):
        s = 0.7
    else:
        return 0.0
    return s + (0.05 if c.get("y", 999) < 120 and c.get("x", 999) < 400 else 0.0)


def is_searchy(c):
    labels = " ".join(t for _, t in c["names"]).lower()
    return c["role"] == "searchbox" or c.get("type") == "search" or \
        "search" in c.get("hints", "") or "search" in labels


def score(query, c, verb="click"):
    """Score one candidate (dict from the page collector) against a spoken target."""
    toks, content, roles = parse_query(query)
    editable = c.get("editable", False)
    best, bonus = 0.0, 0.0
    if not content and "menu" in roles:  # "menu", "hamburger menu"
        best = hamburger_score(c)
        roles = roles - {"menu"}
    else:
        names = c["names"] + ([("type", "submit")] if c.get("type") == "submit" else [])
        seen = set()
        for src, text in sorted(names, key=lambda n: -NAME_WEIGHT.get(n[0], 0.8)):
            camel = src in ("id", "name")
            if (text, camel) in seen:  # aria-label, text and title often agree
                continue
            seen.add((text, camel))
            s = text_sim(content, text, camel)
            if toks != content:
                s = max(s, text_sim(toks, text, camel) * 0.95)
            best = max(best, NAME_WEIGHT.get(src, 0.8) * s)
        if not content and "field" in roles and editable:  # "text box"
            best = max(best, 0.6)
    if "button" in roles:
        bonus += 0.15 if c["role"] in ("button", "clickable") else -0.05
    if "link" in roles:
        bonus += 0.15 if c["role"] == "link" else -0.05
    if "field" in roles:
        bonus += 0.2 if editable else -0.1
    if "tab" in roles and c["role"] == "tab":
        bonus += 0.15
    if "checkbox" in roles:
        bonus += 0.2 if c["role"] in ("checkbox", "switch") else -0.05
    if "menu" in roles and is_menuish(c):
        bonus += 0.25
    if "icon" in roles and not any(src == "text" for src, _ in c["names"]):
        bonus += 0.1
    if "search" in content and editable and is_searchy(c):
        bonus += 0.3 if "field" in roles else 0.05
    if verb in ("focus", "type") and c["role"] == "searchbox":
        bonus += 0.03
    bonus += 0.05 if c.get("inView") else -0.1
    area = max(c.get("w", 0), 0) * max(c.get("h", 0), 0)
    bonus += min(0.03, 0.03 * area / 20000)
    if c.get("weak"):
        bonus -= 0.1
    if c.get("faint"):
        bonus -= 0.05
    return round(best + bonus, 4) if best > 0 else 0.0


def eligible(c, verb):
    if verb in ("focus", "type"):
        return c.get("editable", False)
    return True


def rank(query, cands, verb="click", embed=False, timing=None):
    pool = [c for c in cands if eligible(c, verb)]
    scored = sorted(((score(query, c, verb), c) for c in pool), key=lambda x: -x[0])
    if embed and scored:
        scored = embed_rerank(query, scored, timing)
    return scored


def best_name(c):
    order = ["labelledby", "aria", "label", "text", "value", "title", "placeholder", "alt", "name", "id"]
    for src in order:
        for s, t in c["names"]:
            if s == src and t.strip():
                return t.strip()[:80]
    return c["tag"]


# --------------------------------------------------------------- embedding --

def embeddings(texts):
    import urllib.request
    req = urllib.request.Request(EMBED_URL, data=json.dumps(
        {"model": EMBED_MODEL, "input": texts}).encode(), headers={"content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=2) as r:
        data = json.load(r)["data"]
    return [d["embedding"] for d in sorted(data, key=lambda d: d["index"])]


def cosine(a, b):
    dot = sum(x * y for x, y in zip(a, b))
    return dot / (math.sqrt(sum(x * x for x in a)) * math.sqrt(sum(y * y for y in b)) or 1)


def embed_rerank(query, scored, timing=None, top=40):
    t0 = time.perf_counter()
    head, tail = scored[:top], scored[top:]
    texts = [f"{c['role']}: {best_name(c)}" for _, c in head]
    try:
        vecs = embeddings([query] + texts)
    except (OSError, ValueError, KeyError) as e:  # service down: fuzzy alone
        print(f"hover-page: embeddings unavailable ({e}), using fuzzy only", file=sys.stderr)
        return scored
    out = []
    for (s, c), v in zip(head, vecs[1:]):
        sim = min(1.0, max(0.0, (cosine(vecs[0], v) - 0.2) / 0.6))
        out.append((round(0.6 * s + 0.4 * sim, 4), c))
    if timing is not None:
        timing["embed"] = time.perf_counter() - t0
    return sorted(out, key=lambda x: -x[0]) + [(s * 0.6, c) for s, c in tail]


# ------------------------------------------------------------------- page JS --

COLLECT_JS = r"""
const SEL = 'a[href],button,input,select,textarea,summary,[role=button],[role=link],' +
  '[role=menuitem],[role=tab],[role=searchbox],[role=combobox],[role=textbox],' +
  '[role=checkbox],[role=radio],[role=switch],[role=option],[onclick],' +
  '[contenteditable=""],[contenteditable=true],[aria-label]';
const INTERACTIVE = /^(a|button|input|select|textarea|summary)$/;
const vw = innerWidth, vh = innerHeight, els = [], out = [], REACH = 4;
let far = 0;
const txt = s => (s || '').replace(/\s+/g, ' ').trim().slice(0, 120);
function roleOf(el, tag) {
  const r = el.getAttribute('role');
  if (r) return r.split(' ')[0];
  if (tag === 'a') return 'link';
  if (tag === 'button' || tag === 'summary') return 'button';
  if (tag === 'select') return 'combobox';
  if (tag === 'textarea') return 'textbox';
  if (tag === 'input') {
    const t = (el.type || 'text').toLowerCase();
    if (t === 'search') return 'searchbox';
    if (['checkbox', 'radio'].includes(t)) return t;
    if (['submit', 'button', 'reset', 'image'].includes(t)) return 'button';
    return 'textbox';
  }
  if (el.isContentEditable) return 'textbox';
  return el.hasAttribute('onclick') ? 'clickable' : 'generic';
}
function visit(el) {
  if (!el.matches(SEL)) return;
  const tag = el.localName;
  if (tag === 'input' && el.type === 'hidden') return;
  const r = el.getBoundingClientRect();
  if (r.width < 2 || r.height < 2) return;
  // far below or above the view: nobody says "click" at what they cannot see
  if (r.bottom < -REACH * vh || r.top > (REACH + 1) * vh) { far++; return; }
  if (el.disabled || el.closest('[aria-hidden=true],[inert]')) return;
  if (el.checkVisibility && !el.checkVisibility({visibilityProperty: true})) return;
  const role = roleOf(el, tag);
  const editable = ['textbox', 'searchbox'].includes(role) ||
    (role === 'combobox' && tag === 'input') || el.isContentEditable;
  const names = [];
  const add = (src, s) => { s = txt(s); if (s && !names.some(n => n[1] === s)) names.push([src, s]); };
  const lb = el.getAttribute('aria-labelledby');
  if (lb) add('labelledby', lb.split(/\s+/).map(id => document.getElementById(id)?.textContent || '').join(' '));
  add('aria', el.getAttribute('aria-label'));
  if (el.labels) for (const l of el.labels) add('label', l.innerText);
  if (!['input', 'select', 'textarea'].includes(tag)) add('text', el.innerText);
  if (tag === 'input' && ['submit', 'button', 'reset'].includes(el.type)) add('value', el.value);
  add('title', el.getAttribute('title'));
  add('placeholder', el.getAttribute('placeholder'));
  add('alt', el.getAttribute('alt') || el.querySelector?.('img[alt]')?.getAttribute('alt'));
  add('name', el.getAttribute('name'));
  add('id', el.id);
  const cls = typeof el.className === 'string' ? el.className : '';
  out.push({
    i: els.length, tag, role, type: tag === 'input' ? (el.type || 'text') : '', names, editable,
    hints: (el.id + ' ' + cls + ' ' + (el.getAttribute('name') || '')).toLowerCase().slice(0, 200),
    popup: el.hasAttribute('aria-haspopup'),
    toggle: el.hasAttribute('aria-expanded') && el.hasAttribute('aria-controls'),
    weak: !INTERACTIVE.test(tag) && role === 'generic',
    // opacity 0 is often the real target laid over its label (the checkbox hack)
    faint: getComputedStyle(el).opacity === '0',
    x: Math.round(r.left), y: Math.round(r.top), w: Math.round(r.width), h: Math.round(r.height),
    inView: r.bottom > 0 && r.right > 0 && r.top < vh && r.left < vw,
    key: el.getAttribute('data-t'),
  });
  els.push(el);
}
(function walk(root) {
  for (const el of root.querySelectorAll('*')) {
    visit(el);
    if (el.shadowRoot) walk(el.shadowRoot);
  }
})(document);
document[Symbol.for('hover-page')] = els;
return {url: location.href, title: document.title, cands: out, far};
"""

