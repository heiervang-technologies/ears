class WebSocket:
    """Just enough RFC 6455 for BiDi on localhost: text frames, no extensions.

    The websockets package costs ~80 ms to import, twice the rest of a command."""

    def __init__(self, url, timeout=10):
        m = re.match(r"ws://([^/:]+):(\d+)(/.*)", url)
        host, port, path = m.group(1), int(m.group(2)), m.group(3)
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\n"
                           f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                           "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        self.buf = b""
        while b"\r\n\r\n" not in self.buf:
            self._fill()
        head, self.buf = self.buf.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n")[0]:
            raise OSError(f"websocket upgrade refused: {head.splitlines()[0].decode(errors='replace')}")

    def _fill(self):
        chunk = self.sock.recv(1 << 16)
        if not chunk:
            raise OSError("connection closed")
        self.buf += chunk

    def _read(self, n):
        while len(self.buf) < n:
            self._fill()
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _frame(self, op, data):
        n = len(data)
        head = bytes([0x80 | op]) + (bytes([0x80 | n]) if n < 126 else
                                     struct.pack("!BH", 0x80 | 126, n) if n < 1 << 16 else
                                     struct.pack("!BQ", 0x80 | 127, n))
        mask = os.urandom(4)
        key = (mask * (n // 4 + 1))[:n]
        body = (int.from_bytes(data, "big") ^ int.from_bytes(key, "big")).to_bytes(n, "big")
        self.sock.sendall(head + mask + body)

    def send(self, text):
        self._frame(0x1, text.encode())

    def recv(self):
        parts = []
        while True:
            b0, b1 = self._read(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack("!H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack("!Q", self._read(8))[0]
            data = self._read(n)  # server frames are unmasked
            op = b0 & 0x0F
            if op == 0x9:
                self._frame(0xA, data)
            elif op == 0x8:
                raise OSError("connection closed by hover")
            elif op in (0x0, 0x1, 0x2):
                parts.append(data)
                if b0 & 0x80:
                    return b"".join(parts).decode()

    def close(self):
        try:
            self._frame(0x8, b"")
        except OSError:
            pass
        self.sock.close()


class Bidi:
    def __init__(self, ws):
        self.ws, self.n = ws, 0

    @classmethod
    def connect(cls, port=PORT):
        b = cls(WebSocket(f"ws://127.0.0.1:{port}/session"))
        b.call("session.new", {"capabilities": {}})
        return b

    def close(self):
        try:
            self.call("session.end", {})
        finally:
            self.ws.close()

    def call(self, method, params):
        self.n += 1
        self.ws.send(json.dumps({"id": self.n, "method": method, "params": params}))
        while True:
            msg = json.loads(self.ws.recv())
            if msg.get("id") == self.n:
                if msg.get("type") == "error":
                    raise RuntimeError(f"{msg['error']}: {msg.get('message')}")
                return msg["result"]

    def run(self, context, body, args=None, sandbox=SANDBOX, activate=False):
        target = {"context": context}
        if sandbox:
            target["sandbox"] = sandbox
        res = self.call("script.evaluate", {
            "expression": f"((ARGS) => JSON.stringify((() => {{ {body}\n }})()))({json.dumps(args or {})})",
            "target": target, "awaitPromise": False, "resultOwnership": "none",
            "userActivation": activate})
        if res.get("type") == "exception":
            raise RuntimeError(res["exceptionDetails"]["text"])
        v = res["result"].get("value")
        return json.loads(v) if isinstance(v, str) else v

    def tab_by_url(self, text):
        tree = self.call("browsingContext.getTree", {"maxDepth": 0})
        for c in tree["contexts"]:
            if text in c["url"]:
                return c["context"]
        raise RuntimeError(f"no tab with {text!r} in its URL")

    def selected_context(self):
        """BiDi context id of the tab the user is looking at."""
        try:
            tree = self.call("browsingContext.getTree", {"moz:scope": "chrome", "maxDepth": 0})
            chrome = next(c["context"] for c in tree["contexts"]
                          if c["url"] == "chrome://browser/content/browser.xhtml")
            return self.run(chrome, SELECTED_TAB_JS, sandbox=None)
        except (StopIteration, RuntimeError):
            pass
        # no system access: first content tab that reports itself visible
        tree = self.call("browsingContext.getTree", {"maxDepth": 0})
        for c in tree["contexts"]:
            if c["url"].startswith("chrome://"):
                continue
            if self.run(c["context"], "return document.visibilityState") == "visible":
                return c["context"]
        raise RuntimeError("no visible tab found")


# --------------------------------------------------------------------- CLI --

def parse_args(argv):
    opts = {"dry": False, "embed": False, "notify": False, "timing": False, "json": False,
            "submit": False, "split": False, "port": PORT, "tab": None}
    pos, it = [], iter(argv)
    for a in it:
        if a in ("-h", "--help"):
            opts["help"] = True
        elif a in ("--port", "--tab"):
            opts[a[2:]] = next(it, None)
        elif a.startswith("--") and a[2:] in opts:
            opts[a[2:]] = True
        else:
            pos.append(a)
    opts["port"] = int(opts["port"])
    return pos, opts


def scroll_amount(words):
    w = " ".join(words).lower()
    if not w:
        return 1.0
    if re.search(r"\b(lot|lots|much|way)\b", w):
        return 3.0
    if re.search(r"\b(bit|little|tad|touch)\b", w):
        return 0.35
    m = re.search(r"\d+(\.\d+)?", w)
    return float(m.group()) if m else 1.0


def describe(c):
    return f'{c["role"]} "{best_name(c)}"'


def run(pos, o, timing):
    verb, rest = pos[0], pos[1:]
    t0 = time.perf_counter()
    b = Bidi.connect(o["port"])
    try:
        ctx = b.tab_by_url(o["tab"]) if o["tab"] else b.selected_context()
        timing["connect+tab"] = time.perf_counter() - t0
        if verb in NAV_JS:
            if o["dry"]:
                return 0, f"would go {verb}"
            b.run(ctx, NAV_JS[verb], activate=True)
            return 0, f"went {verb}" if verb != "reload" else "reloaded"
        if verb == "scroll":
            if not rest or rest[0] not in ("up", "down", "top", "bottom"):
                return 2, "scroll needs up|down|top|bottom"
            r = b.run(ctx, SCROLL_JS, {"dir": rest[0], "pages": scroll_amount(rest[1:]),
                                       "dry": o["dry"]}, activate=True)
            return 0, f"{'would scroll' if o['dry'] else 'scrolled'} {r['target']} {rest[0]} {r['from']} -> {r['to']}"
        text = None
        if verb == "type":
            words = " ".join(rest).split() if o["split"] else rest
            if len(words) < 2:
                return 2, "type needs TARGET TEXT"
            splits = [(" ".join(words[:i]), " ".join(words[i:]))
                      for i in range(1, min(5, len(words) - 1) + 1)] if o["split"] \
                else [(rest[0], " ".join(rest[1:]))]
        else:
            splits = [(" ".join(rest), None)]
        t1 = time.perf_counter()
        page = b.run(ctx, COLLECT_JS)
        timing["collect"] = time.perf_counter() - t1
        t2 = time.perf_counter()
        ranked, target = [], ""
        for tgt, txt in splits:  # one split unless --split
            r = rank(tgt, page["cands"], "click" if verb == "list" else verb,
                     embed=o["embed"], timing=timing)
            if not ranked or (r and r[0][0] > ranked[0][0]):
                ranked, target, text = r, tgt, txt
        timing["rank"] = time.perf_counter() - t2 - timing.get("embed", 0)
        if verb == "list":
            return 0, format_list(target, page, ranked, o["json"])
        if not target.strip() or not ranked or ranked[0][0] < THRESHOLD:
            near = f' (best: {describe(ranked[0][1])} {ranked[0][0]:.2f})' if ranked and ranked[0][0] else ""
            return 1, f'no match for "{target}"{near}'
        s, c = ranked[0]
        what = f"{describe(c)} score {s:.2f}"
        if o["dry"]:
            return 0, f"would {verb} {what}" + (f' with "{text}"' if text is not None else "")
        t3 = time.perf_counter()
        r = b.run(ctx, ACT_JS, {"i": c["i"], "verb": verb, "text": text,
                                      "submit": o["submit"]}, activate=True)
        timing["act"] = time.perf_counter() - t3
        if "error" in r:
            return 2, r["error"]
        return 0, f"{r['done']} {what}"
    finally:
        b.close()


def format_list(target, page, ranked, as_json):
    if as_json:
        return json.dumps({"url": page["url"], "title": page["title"],
                           "cands": [dict(c, score=s) for s, c in ranked]}, ensure_ascii=False)
    lines = [f"{page['title']} <{page['url']}> {len(page['cands'])} candidates"
             f" ({page.get('far', 0)} more out of reach)"]
    shown = ranked if target.strip() else [(0, c) for _, c in ranked]
    for s, c in shown[:25 if target.strip() else 200]:
        flag = "" if c["inView"] else " (offscreen)"
        lines.append(f"{s:5.2f}  {describe(c)}{flag}")
    return "\n".join(lines)


def notify(msg):
    import subprocess
    subprocess.Popen(["notify-send", "-t", "2500", "-a", "hover-page",
                      "-h", "string:x-canonical-private-synchronous:voice-cmd", "hover-page", msg],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv):
    pos, o = parse_args(argv)
    verbs = {"click", "focus", "type", "scroll", "list", *NAV_JS}
    if o.get("help") or not pos or pos[0] not in verbs:
        print(__doc__, file=sys.stdout if o.get("help") else sys.stderr)
        return 0 if o.get("help") else 2
    timing = {}
    t0 = time.perf_counter()
    try:
        code, msg = run(pos, o, timing)
    except OSError as e:
        code, msg = 2, f"hover is not listening on port {o['port']} ({e})"
    except Exception as e:  # BiDi/JS failures: report on one line
        code, msg = 2, f"error: {e}"
    timing["total"] = time.perf_counter() - t0
    print(msg if code == 0 else f"hover-page: {msg}", file=sys.stdout if code == 0 else sys.stderr)
    if o["timing"]:
        print(" ".join(f"{k}={v * 1000:.0f}ms" for k, v in timing.items()), file=sys.stderr)
    if o["notify"] and code != 0:
        notify(msg)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
