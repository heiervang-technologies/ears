#!/usr/bin/env bash
#
# ears - Speech recognition daemon
# Press once to start recording, press again to transcribe
# Uses whisper.cpp server backend with CUDA acceleration
#

set -euo pipefail

# Ensure we have the right environment for notifications and clipboard
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Server configuration
WHISPER_CONFIG_FILE="$HOME/.config/ears/server"
if [[ -f "$WHISPER_CONFIG_FILE" ]]; then
    WHISPER_SERVER=$(cat "$WHISPER_CONFIG_FILE")
else
    WHISPER_SERVER="http://127.0.0.1:8178"
fi

STATE_DIR="$XDG_RUNTIME_DIR/ears"
LOCK_FILE="$STATE_DIR/lock"
PID_FILE="$STATE_DIR/recording.pid"
AUDIO_FILE="$STATE_DIR/recording.wav"

# Device configuration
MIC_CONFIG_FILE="$HOME/.config/ears/device"
DEFAULT_MIC="alsa_input.usb-HP__Inc_HyperX_Cloud_II_Wireless_0-00.mono-fallback"

# Load saved device or use default
if [[ -f "$MIC_CONFIG_FILE" ]]; then
    MIC_TARGET=$(cat "$MIC_CONFIG_FILE")
else
    MIC_TARGET="$DEFAULT_MIC"
fi

list_devices() {
    # List available audio input sources via PipeWire
    pw-cli ls Node 2>/dev/null | awk '
        /^[[:space:]]*id [0-9]+,/ {
            # New node - print previous if it was a source
            if (is_source && name != "") {
                printf "%s\t%s\n", name, desc
            }
            is_source = 0; name = ""; desc = ""
        }
        /media\.class = "Audio\/Source"/ { is_source = 1 }
        /node\.name = "/ {
            gsub(/.*node\.name = "/, "")
            gsub(/".*/, "")
            name = $0
        }
        /node\.description = "/ {
            gsub(/.*node\.description = "/, "")
            gsub(/".*/, "")
            desc = $0
        }
        END {
            # Print last entry if it was a source
            if (is_source && name != "") {
                printf "%s\t%s\n", name, desc
            }
        }
    '
}

select_device() {
    local devices
    devices=$(list_devices)

    if [[ -z "$devices" ]]; then
        echo "No audio input devices found" >&2
        exit 1
    fi

    local selection
    selection=$(echo "$devices" | fzf --prompt="Select audio device: " \
        --with-nth=2 \
        --delimiter=$'\t' \
        --height=~50% \
        --border \
        --header="Audio Input Devices")

    if [[ -z "$selection" ]]; then
        echo "No device selected" >&2
        exit 1
    fi

    local device_name
    device_name=$(echo "$selection" | cut -f1)

    # Save selection
    mkdir -p "$(dirname "$MIC_CONFIG_FILE")"
    echo "$device_name" > "$MIC_CONFIG_FILE"

    echo "Selected: $(echo "$selection" | cut -f2)"
    echo "Device ID: $device_name"
    echo "Saved to: $MIC_CONFIG_FILE"
}

show_current() {
    echo "Current device: $MIC_TARGET"
    if [[ -f "$MIC_CONFIG_FILE" ]]; then
        echo "Config file: $MIC_CONFIG_FILE"
    else
        echo "(using default)"
    fi
}

set_server() {
    local server="$1"
    mkdir -p "$(dirname "$WHISPER_CONFIG_FILE")"
    echo "$server" > "$WHISPER_CONFIG_FILE"
    echo "Server set to: $server"
}

show_server() {
    echo "Current server: $WHISPER_SERVER"
    if [[ -f "$WHISPER_CONFIG_FILE" ]]; then
        echo "Config file: $WHISPER_CONFIG_FILE"
    else
        echo "(using default)"
    fi
}

# Handle arguments
case "${1:-}" in
    --select|-s)
        select_device
        exit 0
        ;;
    --list|-l)
        list_devices | column -t -s $'\t'
        exit 0
        ;;
    --current|-c)
        show_current
        exit 0
        ;;
    --server)
        if [[ -n "${2:-}" ]]; then
            set_server "$2"
        else
            show_server
        fi
        exit 0
        ;;
    --help|-h)
        echo "Usage: ears [OPTION]"
        echo ""
        echo "Without options: Toggle recording/transcription"
        echo ""
        echo "Options:"
        echo "  -s, --select       Select audio device with fzf"
        echo "  -l, --list         List available audio devices"
        echo "  -c, --current      Show current device"
        echo "  --server [URL]     Show or set whisper server URL"
        echo "  -h, --help         Show this help"
        exit 0
        ;;
esac

mkdir -p "$STATE_DIR"

# Acquire lock
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    exit 0  # Another instance is running, silently exit
fi

beep() {
    # Quick audio feedback - much faster than notifications
    local sound="$1"
    if [[ -f "$HOME/.local/share/ears-sounds/${sound}.wav" ]]; then
        paplay "$HOME/.local/share/ears-sounds/${sound}.wav" 2>/dev/null &
    else
        paplay "/usr/share/sounds/freedesktop/stereo/${sound}.oga" 2>/dev/null &
    fi
}

notify() {
    local urgency="${2:-normal}"
    notify-send -u "$urgency" -a "ears" "$1"
}

cleanup_stale() {
    # Clean up any stale processes or files
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
        if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
            # PID file exists but process is dead
            rm -f "$PID_FILE" "$AUDIO_FILE"
        fi
    fi
}

start_recording() {
    # Check if server is running
    if ! curl -sf "$WHISPER_SERVER/health" >/dev/null 2>&1; then
        beep "bell"
        notify "Whisper server not running!" critical
        exit 1
    fi

    # Clean up any old audio file
    rm -f "$AUDIO_FILE"

    # Start recording with PipeWire, explicitly target mic to avoid OBS conflicts
    # Max 2 minutes (120s) to prevent runaway recordings
    timeout 120 pw-record --target "$MIC_TARGET" --rate 16000 --channels 1 --format s16 "$AUDIO_FILE" 200>&- &
    echo $! > "$PID_FILE"

    beep "start"  # High beep for start
}

stop_and_transcribe() {
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || echo "")

    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        beep "bell"
        notify "No active recording" low
        cleanup_stale
        exit 1
    fi

    # Stop recording
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"

    # Wait for file to be fully written
    sleep 0.3

    if [[ ! -f "$AUDIO_FILE" ]] || [[ ! -s "$AUDIO_FILE" ]]; then
        beep "bell"
        notify "Recording file is empty or missing" critical
        rm -f "$AUDIO_FILE"
        exit 1
    fi

    # Send to whisper server
    local response
    if ! response=$(curl -sf -X POST "$WHISPER_SERVER/inference" \
        -F "file=@$AUDIO_FILE" \
        -F "response_format=json" 2>&1); then
        beep "bell"
        notify "Transcription failed: ${response:0:50}" critical
        rm -f "$AUDIO_FILE"
        exit 1
    fi

    # Extract text from response
    local text
    text=$(echo "$response" | jq -r '.text // empty' 2>/dev/null | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    if [[ -z "$text" ]]; then
        beep "bell"
        notify "No speech detected" low
        rm -f "$AUDIO_FILE"
        exit 0
    fi

    # Filter whisper silence artifact
    if [[ "$text" == "Thank you." ]]; then
        beep "bell"
        notify "No speech detected" low
        rm -f "$AUDIO_FILE"
        exit 0
    fi

    # Type the text directly
    ydotool type "$text" 200>&-

    beep "done"  # Success beep

    rm -f "$AUDIO_FILE"
}

# Clean up any stale state first
cleanup_stale

# Debug logging
LOG_FILE="$STATE_DIR/debug.log"
echo "$(date): Script invoked" >> "$LOG_FILE"
echo "$(date): PID_FILE exists: $(test -f "$PID_FILE" && echo yes || echo no)" >> "$LOG_FILE"
if [[ -f "$PID_FILE" ]]; then
    PID_CONTENT=$(cat "$PID_FILE")
    echo "$(date): PID in file: $PID_CONTENT" >> "$LOG_FILE"
    if kill -0 "$PID_CONTENT" 2>/dev/null; then
        echo "$(date): Process is alive, stopping..." >> "$LOG_FILE"
    else
        echo "$(date): Process is dead" >> "$LOG_FILE"
    fi
fi

# Main toggle logic
if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "$(date): Calling stop_and_transcribe" >> "$LOG_FILE"
    stop_and_transcribe
else
    echo "$(date): Calling start_recording" >> "$LOG_FILE"
    start_recording
fi
echo "$(date): Script finished" >> "$LOG_FILE"
