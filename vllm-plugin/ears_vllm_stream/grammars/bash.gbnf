# Bash "voice dictation" grammar (GBNF / xgrammar-compatible).
#
# Purpose: when you SPEAK shell commands out loud ("ls", "git status",
# "cargo build"), constrain the ASR output to valid lowercase bash syntax so
# short/ambiguous tokens land as code ("ls", not "LS"/"Alice"/"eles") instead of
# the model's prose interpretation. This is dictation biasing, NOT translation —
# you say the command, the grammar keeps it structurally valid bash.
#
# Two users, one file (canonical copy lives in the vLLM plugin package;
# `grammars/bash.gbnf` at the repo root is a symlink the Rust client embeds):
#
# * ears' HTTP path sends it whole to vLLM /v1/chat/completions via
#   structured_outputs.grammar (src/whisper.rs, transcribe_chat_internal).
#   `root` is the entry rule there.
# * The ears stream plugin (`/v1/ears/stream`) decodes with the settled
#   transcript forced into the prompt, so after the first settled words the
#   model writes only a continuation. A grammar per prefix would need a fresh
#   xgrammar compile per decode (seconds on this vocab), so the plugin swaps
#   in a fixed entry rule instead: `root` before anything settled, and after
#   that `cont` (the prefix ends a word), `cont_dq` / `cont_sq` (the prefix
#   ends inside an open "..." / '...' string). Each variant compiles once and
#   stays cached. Rules named `body`, `cont`, `cont_dq` and `cont_sq` are the
#   plugin's contract; see vllm-plugin/ears_vllm_stream/grammar.py.
#
# CRITICAL — the `scaffold` rule:
#   Qwen3-ASR emits a "language <Lang><asr_text>" preamble before the actual
#   transcription. If the grammar forces the first token to be a command (i.e.
#   skips this preamble), the model drops OUT of its audio-conditioned regime and
#   free-runs on priors (every utterance collapses to the same token). Anchoring
#   the scaffold keeps audio cross-attention engaged so the constrained body
#   actually tracks what was spoken. The client strips everything up to and
#   including "<asr_text>" from the response.
#
# The body is optional: on silence the model says "language None<asr_text>"
# and stops. A mandatory body forced a command out of nothing ("unzip").
#
# Bounded {m,n} repetition is deliberate: it prevents runaway token loops
# (e.g. "dirdirdir...") on hard-to-parse audio.
#
# Lowercase-only: flag/word/path character classes exclude uppercase so
# dictated commands can never land as "Ls"/"GIT". Quoted strings remain free.
# Sentence punctuation: words cannot end in "." or ",", but a command may
# end with one "." (`stop`), which the client strips. Without that outlet a
# model that wants "git status." takes the "." as the start of an extension
# and is then forced to invent one ("git status.md").
#
# Scope: an allow-list of common commands (or a path to a script) plus generic
# arg/flag/path/pipe/redirect structure. NOT full POSIX (no subshells, command
# substitution, heredocs, arithmetic, brace expansion).

root      ::= scaffold body?

# Qwen3-ASR preamble — keep the model in its transcription regime.
scaffold  ::= "language " [A-Za-z]+ "<asr_text>"

body      ::= pipeline (seq pipeline)* stop
stop      ::= "."?

# Continuations after a settled prefix (stream plugin only, see above).
cont      ::= tail{0,40} stop
tail      ::= ws arg | ws "|" ws command | seq pipeline
cont_dq   ::= dqchar{0,60} "\"" cont
cont_sq   ::= sqchar{0,60} "'" cont

pipeline  ::= command (ws "|" ws command)*
command   ::= cmd (ws arg)*

# Allow-listed commands. Extend as real usage demands.
cmd ::= "ls" | "cd" | "pwd" | "cat" | "echo" | "grep" | "find" | "git"
      | "docker" | "kubectl" | "ssh" | "scp" | "ps" | "kill" | "mkdir"
      | "rmdir" | "rm" | "cp" | "mv" | "touch" | "ln" | "which" | "whoami"
      | "head" | "tail" | "less" | "wc" | "sort" | "uniq" | "cut" | "tr"
      | "awk" | "sed" | "xargs" | "curl" | "wget" | "tar" | "gzip" | "unzip"
      | "make" | "cargo" | "npm" | "node" | "python" | "python3" | "pip"
      | "go" | "rustc" | "bash" | "sh" | "zsh" | "sudo" | "chmod" | "chown"
      | "df" | "du" | "free" | "top" | "htop" | "man" | "export" | "env"
      | "source" | "history" | "clear" | "exit" | "systemctl" | "journalctl"
      | "ping" | "ip" | "ifconfig" | "netstat" | "diff" | "tmux" | "vim"
      | "nvim" | "nano" | "yay" | "pacman" | "hyprctl" | "gh" | "jq" | "rg"
      | "fd" | "bat" | "eza" | "uv" | "pnpm" | "bun" | "npx" | "helm" | "k9s"
      | "rsync" | "watch" | "time" | "nohup" | "btop" | "nvidia-smi"
      | "ffmpeg" | "pactl" | "wpctl" | "say" | "director" | "claude" | "ears"
      | "code" | "open" | "xdg-open" | "pkill" | "killall" | "lsblk"
      | "mount" | "umount" | "zip" | "file" | "stat" | "date" | "uname"
      | path

arg ::= redirect | flag | string | path | word

# Short flags (-l, -rf) and long flags (--all, --color=auto).
flag ::= "--" word ("=" (word | string))? | "-" flagchar{1,8}

# Bare words: filenames, args, subcommands, hostnames, etc.
word ::= wordchar{0,39} wordend

# Paths anchored to a recognizable root so they don't collide with bare words.
path ::= ("/" | "./" | "../" | "~/") pathchar{0,60} | ".." | "~"

# Quoted strings (double and single).
string ::= "\"" dqchar{0,60} "\"" | "'" sqchar{0,60} "'"

# Redirections: > >> < 2> 2>&1
redirect ::= redirop (ws (path | word))?
redirop  ::= "2>&1" | "2>" | ">>" | ">" | "<"

# Command separators: ; && ||
seq ::= ws ("&&" | "||" | ";") ws

ws ::= " "

flagchar ::= [a-z0-9]
wordchar ::= [a-z0-9._+=@:,%/$~-]
wordend  ::= [a-z0-9_+=@:%/$~-]
pathchar ::= [a-z0-9._/~-]
dqchar   ::= [^"\\]
sqchar   ::= [^']
