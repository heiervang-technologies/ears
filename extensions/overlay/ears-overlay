#!/usr/bin/python3
# ears-overlay: the ears light and subtitles (a Quickshell scene). Part of
# the ears repo, extensions/overlay; see its README.md.
"""The ears overlay: the bottom edge of every screen shows whether ears VAD has
the microphone open, and moves like liquid with your voice.

  off        a dim grey line: nothing is recorded
  listening  cyan: what you say is typed where the cursor is
             yellow: it goes to the talking stick (agent-tools `talking-stick listen`)
             green, the call: you answered an agent's call (it asked for
             the talking stick); what you say goes to that agent alone
             pale blue: typing is off and nothing takes it
             green: a push-to-talk voice command (ears-embed) is recording
             violet: command mode ("command" said alone): speech is routed
             to actions by embedding, nothing is typed
  standby    orange: the mic is open, but only the wake phrase is acted on
  fault      red, breathing slowly: the mic is open but ears is not hearing
             (no audio arriving, capture stopped), its health report has
             gone stale, or the ASR server is down; words will not arrive
  warning    the normal colour with a reddish rim: the ASR server is slow or
             ears fell back to a worse path, or the mic delivers silence

Decisions (red): while `ears decide` has a question open, the line turns
red and the question and its options float above the subtitles; read one
out (or its number). The one taken swells and the rest fall back; what
matched nothing shakes the row and shows as "? what was heard". A decision
with room for your own answer (--other) shows it in place of that line.
With a timeout (a quick time event) a bar under them drains from left
to right over exactly that time.

Every feed line carries "tone", the colour the line is drawn in. Mode
changes (no level) also go to $XDG_RUNTIME_DIR/ears/led.json for other
consumers, e.g. a desktop shader following the ears colour.

Subtitles: while `ears subtitles on`, what ears hears is drawn centred just
above the line, small and translucent in the line's colour, fuller while you
speak, the words still forming fainter, a recognised command radiant,
while a small "CC" at the right end of the line says the current mode is
captioned (config subtitle_modes: standby, dictation, command), and fades a few seconds after
the utterance is committed (ears writes $XDG_RUNTIME_DIR/ears/subtitle.json).

While you speak the edge swells into layered waves; when you stop it settles
flat, and at rest nothing is redrawn. It is click-through and never takes
focus. One Quickshell scene (embedded below) draws it on every screen; this
tool's `feed` gives it the state and the mic level as JSON lines.

Start it with `ears-overlay start` (or the ears-overlay.service user unit,
which runs the scene in the foreground). Opt out with
~/.config/ears/no-overlay. Yellow (talking stick), green (a call) and the
ears-embed push-to-talk colour come from HAIos tools; without them those
states simply never show.

The state is never taken from a file alone: VAD counts as running only while
the pid in $XDG_RUNTIME_DIR/ears/vad.pid is alive. The level is read from the
device ears records from, and only while VAD runs, so this never opens a
microphone that ears has closed. Faults come from ears' own health report
($XDG_RUNTIME_DIR/ears/vad-health.json), and only while it belongs to that
live VAD process in this boot. The feed never blocks on the microphone: a
recorder that goes quiet is restarted, and the state is re-read twice a second
whether or not audio arrives.
"""

from __future__ import annotations

import json
import math
import os
import shutil
import signal
import struct
import subprocess
import sys
import re
import select
import time

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
EARS_RUN = os.environ.get("EARS_OVERLAY_RUN", os.path.join(RUNTIME, "ears"))
PROC = os.environ.get("EARS_OVERLAY_PROC", "/proc")
EARS_CONFIG = os.environ.get("EARS_OVERLAY_CONFIG", os.path.expanduser("~/.config/ears/config.toml"))
BOOT_ID = os.environ.get("EARS_OVERLAY_BOOT_ID", "/proc/sys/kernel/random/boot_id")
OPT_OUT = os.path.expanduser("~/.config/ears/no-overlay")
SCENE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "ears", "overlay")
RATE = 16000
CHUNK = RATE // 20  # 50 ms
FLOOR_DB = -70.0
SPAN_DB = 30.0  # from the room's noise floor to a full wave


def embed_recording() -> bool:
    """ears-embed (push-to-talk voice commands by embedding) has the mic open."""
    try:
        with open(os.path.join(RUNTIME, "ears-embed.pid")) as f:
            os.kill(int(f.read().split()[0]), 0)
        return True
    except (OSError, ValueError, IndexError):
        return False


def state() -> str:
    if embed_recording():
        return "listening"
    try:
        with open(os.path.join(EARS_RUN, "vad.pid")) as f:
            pid = int(f.read().split()[0])
        os.kill(pid, 0)
    except (OSError, ValueError, IndexError):
        return "off"
    return "standby" if os.path.exists(os.path.join(EARS_RUN, "vad.standby")) else "listening"


def typing_on() -> bool:
    path = os.environ.get("EARS_TYPING_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "ears", "typing")
    try:
        with open(path) as f:
            return f.read().strip() != "off"
    except OSError:
        return True  # ears: a missing file means typing is on


def stick_listening() -> bool:
    for pid in os.listdir(PROC):
        if not pid.isdigit():
            continue
        try:
            with open(os.path.join(PROC, pid, "cmdline"), "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        names = [os.path.basename(a) for a in argv[:3]]
        if b"talking-stick" in names and b"listen" in argv[:4]:
            return True
    return False


CALL_FILE = os.environ.get("HAIOS_CALL_FILE") or os.path.join(RUNTIME, "haios-call.json")


def on_call() -> bool:
    """A call is live: haios-holocall call keeps its pid in haios-call.json."""
    try:
        with open(CALL_FILE) as f:
            os.kill(int(json.load(f)["pid"]), 0)
        return True
    except (OSError, ValueError, KeyError, TypeError):
        return False


def command_mode() -> bool:
    """ears VAD is in command mode (marker written by ears, ears#230)."""
    return os.path.exists(os.path.join(EARS_RUN, "vad.command"))


def decision() -> dict | None:
    """The decision `ears decide` has open, while its asker lives."""
    try:
        with open(os.path.join(EARS_RUN, "decision.json")) as f:
            d = json.load(f)
        os.kill(int(d["pid"]), 0)
        return d if d.get("options") else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def vision() -> dict | None:
    """What `ears look` is showing (vision mode, pink), while it runs."""
    try:
        with open(os.path.join(EARS_RUN, "vision.json")) as f:
            v = json.load(f)
        os.kill(int(v["id"]), 0)
        return v
    except (OSError, ValueError, KeyError, TypeError):
        return None


def route() -> str:
    """Where VAD sends words: the cursor, the talking stick, a call, or nowhere
    (typing off and nobody listening: they are only published), a
    push-to-talk voice command (ears-embed), actions (command mode), or the
    answer to an open decision (red; it takes every utterance). Vision
    mode (pink) outranks its own confirming decision."""
    if vision() is not None or os.path.exists(os.path.join(EARS_RUN, "vad.vision")):
        return "vision"
    if decision() is not None:
        return "decide"
    if embed_recording():
        return "command"
    if command_mode():
        return "embed"
    if on_call():
        return "call"
    if typing_on():
        return "cursor"
    return "stick" if stick_listening() else "none"


def ears_config() -> dict:
    try:
        with open(EARS_CONFIG, "rb") as f:
            raw = f.read()
    except OSError:
        return {}
    if tomllib:
        try:
            return tomllib.loads(raw.decode())
        except (tomllib.TOMLDecodeError, UnicodeDecodeError):
            return {}
    # Without tomllib: just the two keys used here.
    text = raw.decode(errors="replace")
    config: dict = {}
    device = re.search(r'^device\s*=\s*"([^"]*)"', text.split("\n[", 1)[0], re.M)
    if device:
        config["device"] = device.group(1)
    commands = re.search(r"^\[commands\]\s*$(.*?)(?=^\[|\Z)", text, re.M | re.S)
    if commands and re.search(r"^enabled\s*=\s*true\b", commands.group(1), re.M):
        config["commands"] = {"enabled": True}
    return config


def wanted() -> tuple[bool, str]:
    if os.path.exists(OPT_OUT):
        return False, f"opted out ({OPT_OUT})"
    beside = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "ears")
    if not shutil.which("ears") and not os.access(beside, os.X_OK):
        return False, "ears is not installed"
    if not shutil.which("qs"):
        return False, "quickshell (qs) is not installed"
    return True, "ears and quickshell are installed"


HEALTH_STALE_MS = 5000   # ears rewrites its health report every second
NO_AUDIO_MS = 3000       # same bound as ears' own "no audio arriving"
RECORDER_QUIET_S = 2.0   # our own recorder: restart it after this long without data
RECORDER_BACKOFF_MAX_S = 10.0
CHECK_EVERY_S = 0.5


def _read(path: str) -> str | None:
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def _vad_pid() -> int | None:
    try:
        pid = int((_read(os.path.join(EARS_RUN, "vad.pid")) or "").split()[0])
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError, IndexError):
        return None


def _start_ticks(pid: int) -> str | None:
    stat = _read(os.path.join(PROC, str(pid), "stat"))
    if not stat:
        return None
    fields = stat.rsplit(")", 1)[-1].split()
    return fields[19] if len(fields) > 19 else None


def health() -> dict | None:
    """ears' health report, only while it belongs to the live VAD process of
    this boot; a leftover file from a dead or other process is ignored."""
    pid = _vad_pid()
    if pid is None:
        return None
    try:
        h = json.loads(_read(os.path.join(EARS_RUN, "vad-health.json")) or "")
    except ValueError:
        return None
    if not isinstance(h, dict) or h.get("pid") != pid:
        return None
    boot = (_read(BOOT_ID) or "").strip()
    if boot and h.get("boot_id") and h["boot_id"] != boot:
        return None
    ticks = _start_ticks(pid)
    if ticks and h.get("process_start_ticks") and str(h["process_start_ticks"]) != ticks:
        return None
    return h


def diagnose(h: dict | None, now_ms: int | None = None) -> tuple[str | None, str | None]:
    """(fault, warning) from a health report: fault means words will not
    arrive, warning means they arrive worse or slower."""
    if h is None:
        return None, None
    now = int(time.monotonic() * 1000) if now_ms is None else now_ms
    try:
        if now - int(h.get("updated_monotonic_ms", 0)) > HEALTH_STALE_MS:
            return "stale", None
        if h.get("capture_error"):
            return "mic", None
        last = h.get("capture_last_ms")
        since = int(last) if last is not None else int(h.get("stage_since_ms", now))
        if now - since > NO_AUDIO_MS:
            return "mic", None
    except (TypeError, ValueError):
        return "stale", None
    asr = h.get("asr")
    asr_state = asr.get("state") if isinstance(asr, dict) else None
    if asr_state == "down":
        return "asr", None
    if asr_state == "degraded":
        return None, "asr-degraded"
    if h.get("mic_warning") == "mic silent":
        return None, "mic-silent"
    return None, None


def captioned(s: str, where: str) -> bool:
    """Subtitles show in the current mode: the marker ears keeps while they
    are on lists the modes they show in (`subtitle_modes`)."""
    if s == "off":
        return False
    try:
        with open(os.path.join(EARS_RUN, "subtitles.on")) as f:
            modes = f.read().split() or ["standby", "dictation", "command"]
    except OSError:
        return False
    mode = ("decide" if where == "decide" else "standby" if s == "standby"
            else "command" if where == "embed" else "dictation")
    return mode in modes


FAULT_TONE = "#f05a5a"
# Steady where a fault breathes, and deeper.
DECIDE_TONE = "#ff3344"
# Vision mode (`ears look`): pink, since cyan is dictation's.
VISION_TONE = "#ff4fd8"


def tone(s: str, where: str, fault: str | None) -> str:
    """The colour the line is drawn in: the one palette for every consumer."""
    if s != "off" and fault:
        return FAULT_TONE
    if s != "off" and where == "decide":
        return DECIDE_TONE
    if where == "vision":
        return VISION_TONE
    if s == "standby":
        return "#ff9e1f"
    if s != "listening":
        return "#6b7280"
    return {"stick": "#facc15", "call": "#22c55e", "command": "#1fe88a", "embed": "#a78bfa",
            "none": "#8fb8c4"}.get(where, "#22d3ee")


# Mode changes only (no level), for other consumers: a file is cheaper
# than a second feed, which would open a second recorder.
STATE_FILE = os.path.join(EARS_RUN, "led.json")
_last_state: dict | None = None


def publish(line: dict) -> None:
    global _last_state
    state = {k: line[k] for k in ("state", "route", "fault", "warn", "cc", "tone")}
    if state == _last_state:
        return
    _last_state = state
    try:
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATE_FILE)
    except OSError:
        pass


def emit(s: str, level: float = 0.0, where: str = "cursor",
         fault: str | None = None, warn: str | None = None) -> None:
    line = {"state": s, "route": where, "level": round(level, 3),
            "fault": fault, "warn": warn, "cc": captioned(s, where),
            "tone": tone(s, where, fault)}
    print(json.dumps(line), flush=True)
    publish(line)


class Subtitle:
    """Pass ears' subtitle line to the scene when it changes."""

    def __init__(self) -> None:
        self.path = os.path.join(EARS_RUN, "subtitle.json")
        self.seen: int | None = None

    def poll(self) -> None:
        try:
            stamp = os.stat(self.path).st_mtime_ns
        except OSError:
            stamp = None
        if stamp == self.seen:
            return
        self.seen = stamp
        line = {"text": "", "settled": 0, "final": True}
        if stamp is not None:
            try:
                with open(self.path) as f:
                    line = json.load(f)
            except (OSError, ValueError):
                return
        print(json.dumps({"subtitle": line}), flush=True)


class Vision:
    """Pass what `ears look` shows (or its end) to the scene when it changes."""

    def __init__(self) -> None:
        self.path = os.path.join(EARS_RUN, "vision.json")
        self.seen: tuple | None = None

    def poll(self) -> None:
        try:
            stamp = os.stat(self.path).st_mtime_ns
        except OSError:
            stamp = None
        v = vision() if stamp is not None else None
        key = (stamp, v is not None)
        if key == self.seen:
            return
        self.seen = key
        if v is not None:
            v["stamp"] = stamp
        print(json.dumps({"vision": v}), flush=True)


class Chant:
    """Pass chant mode's meters (chant.json) to the scene while chanting
    (the vad.chant marker), and its end."""

    def __init__(self) -> None:
        self.marker = os.path.join(EARS_RUN, "vad.chant")
        self.path = os.path.join(EARS_RUN, "chant.json")
        self.seen: tuple | None = None

    def poll(self) -> None:
        on = os.path.exists(self.marker)
        try:
            stamp = os.stat(self.path).st_mtime_ns if on else None
        except OSError:
            stamp = None
        key = (on, stamp)
        if key == self.seen:
            return
        self.seen = key
        line = None
        if on:
            line = {"meters": [], "heard": "", "live": False}
            if stamp is not None:
                try:
                    with open(self.path) as f:
                        line = json.load(f)
                except (OSError, ValueError):
                    return
        print(json.dumps({"chant": line}), flush=True)


class Decision:
    """Pass the open decision (or its end) to the scene when it changes,
    and what ears made of each answer (decision-last.json) for feedback."""

    def __init__(self) -> None:
        self.seen: str | None = None
        self.last = os.path.join(EARS_RUN, "decision-last.json")
        self.heard: int | None = None

    def poll(self) -> None:
        # Feedback first: an answer closes the decision in the same breath.
        try:
            stamp = os.stat(self.last).st_mtime_ns
        except OSError:
            stamp = None
        if stamp is not None and stamp != self.heard:
            self.heard = stamp
            try:
                with open(self.last) as f:
                    print(json.dumps({"decided": json.load(f)}), flush=True)
            except (OSError, ValueError):
                pass
        d = decision()
        key = d.get("id") if d else None
        if key == self.seen:
            return
        self.seen = key
        print(json.dumps({"decision": d}), flush=True)


_HAS_RAW: bool | None = None


def pw_record_has_raw() -> bool:
    global _HAS_RAW
    if _HAS_RAW is None:
        try:
            out = subprocess.run(["pw-record", "--help"], capture_output=True, text=True,
                                 timeout=5)
            _HAS_RAW = "--raw" in out.stdout + out.stderr
        except (OSError, subprocess.SubprocessError):
            _HAS_RAW = False
    return _HAS_RAW


def capture_device() -> str | None:
    """The microphone ears really records from: the device it opened (its
    health report, e.g. a fallback when the configured mic is missing), else
    the configured one. Recording the configured mic while ears fell back to
    another gives a flat edge (2026-11-16: headset gone, desk mic in use)."""
    opened = (health() or {}).get("device_opened")
    if isinstance(opened, str) and opened:
        return opened
    return ears_config().get("device")


def record() -> subprocess.Popen:
    override = os.environ.get("EARS_OVERLAY_RECORDER")
    if override:  # tests: a stand-in recorder
        return subprocess.Popen(["/bin/sh", "-c", override], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL)
    cmd = ["pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16",
           "--properties", "node.dont-reconnect=true", "-"]
    # Raw samples on stdout: PipeWire 1.6.10 otherwise writes a big-endian
    # Sun/AU container there, read as full-scale noise (ears#226).
    if pw_record_has_raw():
        cmd.insert(-1, "--raw")
    device = capture_device()
    if device:
        cmd[1:1] = ["--target", device]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def stop_recorder(rec: subprocess.Popen | None) -> None:
    if rec is None:
        return
    try:
        rec.kill()
    except OSError:
        pass
    try:
        rec.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def cmd_feed(once: bool) -> int:
    def look() -> tuple[str, str, str | None, str | None]:
        s = state()
        where = route()
        fault, warn = diagnose(health()) if s != "off" and where != "command" else (None, None)
        if where == "embed":
            # Command mode does not transcribe: the ASR server is not in the path.
            fault = None if fault == "asr" else fault
            warn = None if warn == "asr-degraded" else warn
        return s, where, fault, warn

    if once:
        s, where, fault, warn = look()
        emit(s, 0.0, where, fault, warn)
        return 0

    # Ended by the scene (SIGTERM/SIGHUP): unwind, so the recorder is reaped.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))
    rec: subprocess.Popen | None = None
    rec_device: str | None = None
    buf = b""
    noise = None
    level = 0.0
    backoff = 0.5
    start_at = 0.0
    last_data = 0.0
    checked = 0.0
    s, where, fault, warn = "off", "cursor", None, None
    shown = None
    subtitle = Subtitle()
    asked = Decision()
    looked = Vision()
    chanted = Chant()
    try:
        while True:
            now = time.monotonic()
            subtitle.poll()
            asked.poll()
            looked.poll()
            chanted.poll()
            if now - checked >= CHECK_EVERY_S:
                checked = now
                s, where, fault, warn = look()
                if s == "off":
                    stop_recorder(rec)
                    rec, buf, noise, level = None, b"", None, 0.0
                elif rec is not None and capture_device() != rec_device:
                    # ears switched mics (fallback, or back): follow it.
                    stop_recorder(rec)
                    rec, buf, noise, level, start_at = None, b"", None, 0.0, now
                current = (s, where, fault, warn)
                if s != "off" or current != shown:
                    # While the mic is open, emit at least twice a second so
                    # the scene sees state changes even without audio.
                    emit(s, level if rec else 0.0, where, fault, warn)
                    shown = current
            if s == "off":
                time.sleep(CHECK_EVERY_S)
                continue
            if rec is None and now >= start_at:
                rec_device = capture_device()
                rec = record()
                os.set_blocking(rec.stdout.fileno(), False)
                last_data, buf = now, b""
            if rec is None:
                time.sleep(0.1)
                continue
            ready, _, _ = select.select([rec.stdout], [], [], 0.1)
            data = b""
            if ready:
                try:
                    data = os.read(rec.stdout.fileno(), 65536)
                except BlockingIOError:
                    data = b""
                if not data and rec.poll() is not None:  # recorder ended
                    stop_recorder(rec)
                    rec, level, start_at = None, 0.0, now + backoff
                    backoff = min(backoff * 2, RECORDER_BACKOFF_MAX_S)
                    continue
            if data:
                last_data = now
                backoff = 0.5
                buf += data
                while len(buf) >= CHUNK * 2:
                    chunk, buf = buf[:CHUNK * 2], buf[CHUNK * 2:]
                    samples = struct.unpack(f"<{CHUNK}h", chunk)
                    rms = math.sqrt(sum(x * x for x in samples) / CHUNK) / 32768
                    db = 20 * math.log10(rms) if rms > 0 else FLOOR_DB
                    # The room's noise floor follows quiet quickly and loud slowly,
                    # so the wave is speech above it and not the fan.
                    if noise is None or db < noise:
                        noise = db if noise is None else noise + (db - noise) * 0.3
                    else:
                        noise += 0.03
                    level = min(1.0, max(0.0, (db - noise - 4) / SPAN_DB))
                    emit(s, level, where, fault, warn)
            elif now - last_data > RECORDER_QUIET_S:
                # A recorder that delivers nothing (its node vanished) is
                # restarted; meanwhile the edge stays flat, never frozen.
                stop_recorder(rec)
                rec, level, start_at = None, 0.0, now + backoff
                backoff = min(backoff * 2, RECORDER_BACKOFF_MAX_S)
    finally:
        stop_recorder(rec)


def scene_path() -> str:
    os.makedirs(SCENE_DIR, exist_ok=True)
    path = os.path.join(SCENE_DIR, "shell.qml")
    text = SCENE.replace("@TOOL@", os.path.realpath(sys.argv[0]))
    try:
        with open(path) as f:
            if f.read() == text:
                return path
    except OSError:
        pass
    with open(path, "w") as f:
        f.write(text)
    return path


def running() -> list[int]:
    out = subprocess.run(["pgrep", "-f", f"^qs -p {SCENE_DIR}/shell.qml$"],
                         capture_output=True, text=True).stdout
    return [int(p) for p in out.split()]


def cmd_start() -> int:
    ok, why = wanted()
    if not ok:
        print(f"ears-overlay: not started: {why}")
        return 0
    if running():
        return 0
    path = scene_path()
    subprocess.Popen(["qs", "-p", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def cmd_run() -> int:
    """The scene in the foreground (for a systemd user unit)."""
    ok, why = wanted()
    if not ok:
        print(f"ears-overlay: not started: {why}", file=sys.stderr)
        return 0
    os.execvp("qs", ["qs", "-p", scene_path()])


def cmd_stop() -> int:
    for pid in running():
        os.kill(pid, signal.SIGTERM)
    return 0


def cmd_check() -> int:
    ok, why = wanted()
    print(f"{'wanted' if ok else 'not wanted'}: {why}; vad: {state()}; "
          f"scene: {'running' if running() else 'not running'}")
    return 0 if ok else 1


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "start"
    if cmd == "feed":
        try:
            return cmd_feed("--once" in argv)
        except (BrokenPipeError, KeyboardInterrupt):
            return 0
    if cmd in ("start", "stop", "check", "run"):
        return {"start": cmd_start, "stop": cmd_stop, "check": cmd_check, "run": cmd_run}[cmd]()
    print(__doc__.split("\n\n")[0])
    print("usage: ears-overlay start|stop|check|run|feed [--once]", file=sys.stderr)
    return 2


