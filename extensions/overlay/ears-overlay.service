# The ears overlay (light + subtitles) as a systemd user unit.
#
#   install -Dm644 ears-overlay.service ~/.config/systemd/user/ears-overlay.service
#   systemctl --user daemon-reload && systemctl --user enable --now ears-overlay.service
#
# install.sh --overlay does this, with ExecStart pointing at where it put the tool.

[Unit]
Description=ears overlay (light and subtitles, Quickshell)
Documentation=https://github.com/heiervang-technologies/ears/tree/main/extensions/overlay
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/ears-overlay run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
